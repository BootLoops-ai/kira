+  // cache lock, so this must be thread-safe by itself.
+  static std::atomic<int> s_ctr{0};
+  static thread_local int tid = -1;
+  if (tid < 0) tid = (s_ctr++) % (s_coreNumber > 0 ? s_coreNumber : 1);
